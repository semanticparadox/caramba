<?xml version="1.0" encoding="utf-8"?>
<!--
     Adaptive icon (Android 8.0+, API 26+): используется вместо
     mipmap-*/ic_launcher.png на устройствах, которые умеют накладывать
     собственную маску формы (круг/squircle/капля) лаунчера. Foreground —
     корабль с прозрачным фоном; background — плоский цвет фирменного тёмного
     фона. На API < 26 система берёт обычные mipmap-*/ic_launcher.png
     (оставлены без изменений как fallback).

     ПРО РАЗМЕР КОРАБЛЯ. Маска лаунчера вырезает КРУГ диаметром 72dp из 108dp
     канваса, поэтому «вписать в центральный квадрат 66%» недостаточно: углы
     этого квадрата лежат вне круга, и на эмуляторе так срезало флаг, верх
     мачты и нос. Считать надо по радиусу: самая дальняя непрозрачная точка
     от центра должна быть меньше 144 px при канвасе 432 px. Сейчас она на
     129 px (габарит корабля ~50% канваса) — запас на squircle и другие маски.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
