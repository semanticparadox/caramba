// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Имя бандла (.app) и, через наследование, имя исполняемого файла.
//
// ЗАЧЕМ «Caramba Connect», а не техническое caramba_client. Папка .app это
// то, что человек видит в DMG, в /Applications, в Finder и в Launchpad;
// владелец прямо попросил нормальное имя установки на всех системах. Имя
// бинаря внутри Contents/MacOS (EXECUTABLE_NAME) по умолчанию равно
// PRODUCT_NAME, поэтому Dock, «Завершить принудительно» и Мониторинг системы
// тоже показывают «Caramba Connect» без отдельной настройки.
//
// Пробел в имени переживают все звенья: scripts/build.sh ищет *.app через
// find, scripts/ci-desktop.sh берёт имя бинаря из CFBundleExecutable через
// plutil, а productReference и TEST_HOST в Runner.xcodeproj/project.pbxproj
// переименованы вместе с этой строкой. Bundle id (ниже) не менялся: на нём
// держатся Keychain, настройки и регистрация схем caramba://.
PRODUCT_NAME = Caramba Connect

// Один источник иконки вместо двух.
//
// ЗАЧЕМ. По умолчанию actool кладёт в бандл И каталог Assets.car (на него
// смотрит CFBundleIconName), И легаси-файл Resources/AppIcon.icns, попутно
// дописывая в Info.plist ключ CFBundleIconFile. Проверка собранного .app
// показала, что этот автоматический .icns неполный: в нём только 16, 16@2x,
// 128 и 128@2x, без 256/512/1024. То есть на крупных размерах система берёт
// иконку из источника, где её нет. Каталога хватает с macOS 10.13, а у нас
// цель 12.0, поэтому легаси-файл не нужен вовсе.
ASSETCATALOG_COMPILER_STANDALONE_ICON_BEHAVIOR = none

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.caramba.carambaClient

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.caramba. All rights reserved.
