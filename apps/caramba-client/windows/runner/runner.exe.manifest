<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <!-- Зачем requireAdministrator: туннель на Windows работает через wintun, а
       wintun создаёт сетевой адаптер только из процесса с правами
       администратора. Без этого приложение открывается, но «Подключить» молча
       не поднимает туннель. Цена: один UAC-запрос при каждом запуске (и при
       flutter run на машине разработчика). Инсталлятор (windows/installer)
       тоже ставится с правами администратора, поэтому у пользователя один и
       тот же опыт: подтвердить UAC, дальше всё само. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
