[Unit]
Description=Caramba VPN Node
After=network.target
Before=sing-box.service
# Агент перезапускает себя после самообновления. Лимит стартов systemd превращал
# это в start-limit-hit и оставлял узел без агента; для VPN-узла это худший исход.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/caramba
ExecStart=/opt/caramba/caramba-node
Restart=always
RestartSec=10s
EnvironmentFile=-/opt/caramba/.env
EnvironmentFile=-/opt/caramba/node.env

[Install]
WantedBy=multi-user.target
