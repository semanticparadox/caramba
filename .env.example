# Caramba Panel Configuration
PANEL_URL=https://panel.example.com
ADMIN_PATH=/admin
DATABASE_URL=postgres://user:password@localhost/caramba
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=your-random-session-secret
INTERNAL_API_TOKEN=

# Bot Configuration
BOT_TOKEN=your_bot_token_here

# Payment Configuration (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_API_KEY=
NOWPAYMENTS_KEY=
CRYSTALPAY_LOGIN=
CRYSTALPAY_SECRET=
REQUIRED_CHANNEL_ID=                 # Telegram channel ID (e.g., -1001234567890)

# Paypalych (pal24.pro / pally.info) — SBP + USDT TRC20, RU-friendly.
# API token from the merchant dashboard "API интеграция" (form: `72|xxxxxx`).
# shop_id and webhook_secret are optional.
PAYPALYCH_API_TOKEN=
PAYPALYCH_SHOP_ID=
PAYPALYCH_WEBHOOK_SECRET=
