+// caramba patch (см. libs/caramba-core/patches/README.md): в исходнике
+// package manager создаётся всегда и читает /data/system/packages.xml, что
+// без root невозможно, поэтому TUN-листенер падал в обычном приложении.
+// Per-app правила на Android делает VpnService.Builder, ядру они нужны только
+// если заданы явно; при недоступном package manager правила пропускаются.
 func (l *Listener) buildAndroidRules(tunOptions *tun.Options) error {
+	if len(tunOptions.IncludeAndroidUser) == 0 &&
+		len(tunOptions.IncludePackage) == 0 &&
+		len(tunOptions.ExcludePackage) == 0 {
+		return nil
+	}
 	packageManager, err := getPackageManager()
 	if err != nil {
-		return err
+		log.Warnln("[TUN] android package manager unavailable, per-app rules skipped: %v", err)
+		return nil
 	}
 	tunOptions.BuildAndroidRules(packageManager, l.handler)
 	return nil
